[Desktop Entry]
Version=1.0
Type=Application
Name=Cron Rhythm Studio
GenericName=Cron AST Schedule Parser & 24x7 Rhythm Matrix
Comment=Zero-Dependency AST Schedule Parser, 24x7 Rhythm Matrix, Multi-Dialect Transpiler & DST Anomaly Auditor
Exec=/usr/local/bin/cron-rhythm desktop
Icon=cron-rhythm
Terminal=false
Categories=Development;System;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open Cron Rhythm CLI
Exec=x-terminal-emulator -e "/usr/local/bin/cron-rhythm --help"

[Desktop Action Web]
Name=Open Web UI (Port 5174)
Exec=/usr/local/bin/cron-rhythm web
