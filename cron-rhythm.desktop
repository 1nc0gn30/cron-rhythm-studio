[Desktop Entry]
Version=1.0
Type=Application
Name=CronRhythm Studio
GenericName=Cron AST Parser & 24x7 Rhythm Matrix
Comment=Zero-dependency POSIX/Quartz cron AST parser, 24x7 rhythm heatmap, DST anomaly auditor, fleet optimizer, and multi-dialect transpiler across Kubernetes, GitHub Actions, AWS EventBridge, and Systemd
Exec=/usr/local/bin/cron-rhythm-studio desktop
TryExec=/usr/local/bin/cron-rhythm-studio
Icon=cron-rhythm-studio
Terminal=false
Categories=Development;System;Utility;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch CronRhythm Studio Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "CronRhythm Studio TUI" -- /usr/local/bin/cron-rhythm-studio-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:5174)
Exec=xdg-open http://127.0.0.1:5174
